---
// Layout — app-shell layout for the gallery. A fixed left sidebar holds nav
// or filtering UI; the right pane scrolls. Body height is 100svh so neither
// the page nor the sidebar can ever push the chrome off-screen.
//
// Pages provide their own sidebar via `<aside slot="sidebar">…</aside>`.
// If they don't, a default sidebar shows just the brand and a "Browse"
// link back to the catalog.
import "@fontsource-variable/archivo";
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  /** Theme attribute applied at the document root — flips tokens for the whole page. */
  theme?: "light" | "dark" | "brand";
  /** Frontmatter object, present when this layout is used from a Markdown/MDX page. */
  frontmatter?: { title?: string; theme?: "light" | "dark" | "brand" };
}

const fm = Astro.props.frontmatter ?? {};
const {
  title = fm.title ?? "Astro Miscreants Gallery",
  theme = fm.theme ?? "dark",
} = Astro.props;
const gtagId = import.meta.env.PUBLIC_GTAG_ID;
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {gtagId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
        <script define:vars={{ gtagId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gtagId);
        </script>
      </>
    )}
  </head>
  <body class="app-shell">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-intent focus:text-fg-on-intent"
    >
      Skip to main content
    </a>

    <aside class="app-sidebar" aria-label="Sidebar">
      <slot name="sidebar">
        <div class="flex flex-col gap-4">
          <a href="/" class="block text-fg" aria-label="Astro Miscreants — home">
            <Logo class="h-5 w-auto" />
          </a>
          <a href="/" class="text-xs text-fg-muted hover:text-fg transition">
            ← Browse the catalog
          </a>
        </div>
      </slot>
    </aside>

    <div class="app-main">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* App shell — fixed-width sidebar on the left, scrollable main on the right.
     `100svh` (small viewport height) keeps the chrome anchored on iOS even as
     the URL bar collapses. */
  body.app-shell {
    margin: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-columns: 280px 1fr;
    background: var(--color-canvas);
    color: var(--color-fg);
  }

  .app-sidebar {
    height: 100svh;
    overflow-y: auto;
    border-right: 1px solid var(--color-stroke);
    padding: 1.5rem 1.25rem;
    background: var(--color-canvas);
  }

  .app-main {
    height: 100svh;
    overflow-y: auto;
  }

  /* Mobile — stack the sidebar above the main pane and let the page scroll
     normally. Fixed-height app shell only makes sense on wider screens. */
  @media (max-width: 768px) {
    body.app-shell {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: auto;
      overflow: auto;
    }
    .app-sidebar {
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--color-stroke);
    }
    .app-main {
      height: auto;
    }
  }
</style>
