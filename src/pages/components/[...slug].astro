---
import Layout from "../../layouts/Layout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Logo from "../../components/Logo.astro";
import { getCollection, render } from "astro:content";
import { readFileSync } from "node:fs";
import { extname, join } from "node:path";

export async function getStaticPaths() {
  const all = await getCollection("components");
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Read the source file at build time and pick a Shiki language id from the
// extension. Rendered through CodeBlock, which already supplies a copy
// button, language badge, and syntax highlighting.
const sourcePath = join(process.cwd(), entry.data.sourceFile);
let sourceCode = "";
try {
  sourceCode = readFileSync(sourcePath, "utf8");
} catch {
  sourceCode = `/* Could not read ${entry.data.sourceFile} */`;
}
const ext = extname(entry.data.sourceFile).slice(1);
const langMap: Record<string, string> = {
  astro: "astro",
  ts: "ts",
  tsx: "tsx",
  js: "js",
  jsx: "jsx",
  css: "css",
  html: "html",
};
const sourceLang = langMap[ext] ?? "plaintext";

const categoryLabels: Record<string, string> = {
  primitive: "Primitives",
  block: "Blocks",
  section: "Sections",
  pattern: "Patterns",
  layout: "Layout",
  form: "Forms",
  labs: "Labs",
};

// Sibling links for "more in this category" navigation, shown in the sidebar.
const all = await getCollection("components");
const siblings = all
  .filter((c) => c.data.category === entry.data.category && c.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title={`${entry.data.title} — Astro Miscreants Gallery`} theme="light">
  {/* Sidebar — back link, current component meta, related siblings. */}
  <div slot="sidebar" class="flex h-full flex-col gap-6">
    <div>
      <a href="/" class="block text-fg" aria-label="Astro Miscreants — home">
        <Logo class="h-5 w-auto" />
      </a>
      <a
        href="/"
        class="mt-4 inline-flex items-center gap-1 text-xs text-fg-muted hover:text-fg transition"
      >
        ← Back to gallery
      </a>
    </div>

    <div>
      <p class="text-[10px] uppercase tracking-wider text-fg-subtle">
        {categoryLabels[entry.data.category] ?? entry.data.category}
      </p>
      <h2 class="mt-1 text-sm font-semibold text-fg">{entry.data.title}</h2>
      <p class="mt-2 text-xs text-fg-muted">{entry.data.status}</p>
    </div>

    {siblings.length > 0 && (
      <nav aria-label="Related components" class="flex flex-col gap-2">
        <p class="text-[10px] uppercase tracking-wider text-fg-subtle">
          More in {categoryLabels[entry.data.category] ?? entry.data.category}
        </p>
        <ul class="flex flex-col">
          {siblings.map((s) => (
            <li>
              <a
                href={`/components/${s.id}/`}
                class="block py-1.5 text-xs text-fg-muted hover:text-fg transition"
              >
                {s.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  {/* Main — clean detail page. No section wrappers, no dividers, no patterns. */}
  <main id="main" class="px-8 py-10 max-w-[80rem]">
    <header>
      <p class="text-[11px] uppercase tracking-[0.2em] text-fg-subtle">
        {categoryLabels[entry.data.category] ?? entry.data.category}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-prose text-base text-fg-muted">
        {entry.data.description}
      </p>
      <p class="mt-5 text-xs text-fg-subtle">
        <span class="uppercase tracking-wider mr-2">Source</span>
        <code class="text-fg-muted">{entry.data.sourceFile}</code>
      </p>
    </header>

    <article class="prose-doc mt-10">
      <Content />
    </article>

    {/* Source — full file with copy button. The whole point of the gallery:
        the page tells you what it is, the block lets you take it. */}
    <section id="source" class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight text-fg">Source</h2>
      <p class="mt-2 max-w-prose text-sm text-fg-muted">
        Copy this file into <code class="px-1 py-0.5 bg-panel-muted border border-stroke">{entry.data.sourceFile}</code> in your Astro project.
      </p>
      <CodeBlock
        class="mt-6"
        code={sourceCode}
        lang={sourceLang}
        title={entry.data.sourceFile}
        showLineNumbers
      />
    </section>
  </main>
</Layout>

<style is:global>
  /* Minimal "doc prose" styling for MDX content. Every selector wraps the
     element in `:not(:where(.not-prose, .not-prose *))` so prose styles
     don't bleed into <Preview> blocks (which carry `not-prose`). */
  .prose-doc {
    color: var(--color-fg);
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }
  .prose-doc :where(h2):not(:where(.not-prose, .not-prose *)) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  .prose-doc :where(h3):not(:where(.not-prose, .not-prose *)) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose-doc :where(p):not(:where(.not-prose, .not-prose *)) {
    margin: 0.875rem 0;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }
  .prose-doc :where(ul, ol):not(:where(.not-prose, .not-prose *)) {
    margin: 0.875rem 0;
    padding-left: 1.5rem;
    color: var(--color-fg-muted);
  }
  .prose-doc :where(li):not(:where(.not-prose, .not-prose *)) {
    margin: 0.25rem 0;
  }
  .prose-doc :where(p, li) > :where(code):not(:where(.not-prose, .not-prose *)) {
    background: var(--color-panel-muted);
    border: 1px solid var(--color-stroke);
    padding: 0.05rem 0.35rem;
    font-size: 0.85em;
    color: var(--color-fg);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .prose-doc :where(h2, h3, h4, h5, h6):not(:where(.not-prose, .not-prose *)) {
    overflow-wrap: anywhere;
  }
  .prose-doc :where(pre):not(:where(.not-prose, .not-prose *)) {
    background: var(--color-panel);
    color: var(--color-fg);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-size: 0.85em;
    line-height: 1.6;
    border: 1px solid var(--color-stroke);
  }
  .prose-doc :where(pre code):not(:where(.not-prose, .not-prose *)) {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose-doc :where(table):not(:where(.not-prose, .not-prose *)) {
    width: 100%;
    margin: 1rem 0;
    font-size: 0.875rem;
    border-collapse: collapse;
    border: 1px solid var(--color-stroke);
  }
  .prose-doc :where(th, td):not(:where(.not-prose, .not-prose *)) {
    text-align: left;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-stroke);
    vertical-align: top;
  }
  .prose-doc :where(th):not(:where(.not-prose, .not-prose *)) {
    background: var(--color-panel-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-fg-subtle);
  }
  .prose-doc :where(tr:last-child td):not(:where(.not-prose, .not-prose *)) {
    border-bottom: 0;
  }
  .prose-doc :where(a):not(:where(.not-prose, .not-prose *)) {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-doc :where(a):not(:where(.not-prose, .not-prose *)):hover {
    color: var(--color-intent);
  }
</style>
