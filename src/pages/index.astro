---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { getCollection } from "astro:content";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { execSync } from "node:child_process";

const all = await getCollection("components");

const categoryOrder = ["primitive", "block", "section", "pattern", "layout", "form", "labs"] as const;
type Category = (typeof categoryOrder)[number];
const categoryLabels: Record<Category, string> = {
  primitive: "Primitives",
  block: "Blocks",
  section: "Sections",
  pattern: "Patterns",
  layout: "Layout",
  form: "Forms",
  labs: "Labs",
};

// Resolve a thumbnail by convention. Drop `public/thumbs/<id>.{png,webp,jpg}`
// for any component and the card will use it; otherwise we fall through to
// the category-tinted placeholder.
const thumbsDir = join(process.cwd(), "public", "thumbs");
const thumbExts = ["png", "webp", "jpg", "jpeg", "avif"] as const;
const findThumb = (id: string): string | null => {
  for (const ext of thumbExts) {
    if (existsSync(join(thumbsDir, `${id}.${ext}`))) {
      return `/thumbs/${id}.${ext}`;
    }
  }
  return null;
};

// First-commit time per content file, used for "latest added" sort. Reads
// `git log --diff-filter=A --follow` for each MDX — accurate across clones
// (mtime is reset by git checkout, so we can't trust the filesystem here).
// Falls back to 0 (sorts last) when git history isn't available.
const gitAddedAt = (absPath: string): number => {
  try {
    const out = execSync(
      `git log --diff-filter=A --follow --format=%aI -- "${absPath}"`,
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    ).trim();
    const firstAdd = out.split("\n").pop() ?? "";
    return firstAdd ? Date.parse(firstAdd) : 0;
  } catch {
    return 0;
  }
};

// `entry.filePath` is already an absolute filesystem path string in Astro 6's
// content layer — pass it straight to git.
const components = all
  .map((entry) => ({
    entry,
    thumbUrl: findThumb(entry.id),
    addedAt: entry.filePath ? gitAddedAt(entry.filePath) : 0,
  }))
  .sort((a, b) => b.addedAt - a.addedAt);

const totalCount = all.length;

// Distinct status values, used to populate the status select.
const statuses = [...new Set(all.map((c) => c.data.status))];
---

<Layout title="Astro Miscreants Gallery" theme="light">
  {/* Sidebar — brand, filters, counter, clear-all. Stays fixed while the
      gallery scrolls on the right. */}
  <div slot="sidebar" class="flex h-full flex-col gap-6">
    <div>
      <a href="/" class="block text-fg" aria-label="Astro Miscreants — home">
        <Logo class="h-5 w-auto" />
      </a>
      <p class="mt-3 text-xs text-fg-muted">
        Astro components, copy-paste.
      </p>
    </div>

    <div data-gallery-filters class="flex flex-col gap-3">
      <div class="relative">
        <svg
          class="pointer-events-none absolute top-1/2 left-2.5 h-4 w-4 -translate-y-1/2 text-fg-subtle"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <input
          data-gallery-search
          type="search"
          placeholder="Search…"
          aria-label="Search components"
          aria-keyshortcuts="Meta+K Control+K"
          autocomplete="off"
          class="w-full border border-stroke bg-panel py-2 pr-14 pl-8 text-sm text-fg placeholder:text-fg-subtle outline-none focus:border-focus"
        />
        <kbd
          data-gallery-search-shortcut
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-1.5 inline-flex -translate-y-1/2 items-center gap-0.5 border border-stroke bg-panel-muted px-1.5 py-0.5 font-sans text-[10px] font-medium leading-none text-fg-muted select-none"
        >
          <span data-gallery-search-shortcut-mod>Ctrl</span>
          <span>K</span>
        </kbd>
        <button
          type="button"
          data-gallery-search-clear
          aria-label="Clear search"
          hidden
          class="absolute top-1/2 right-2 inline-flex h-5 w-5 -translate-y-1/2 items-center justify-center text-fg-muted hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-focus"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <select
        data-gallery-filter="category"
        aria-label="Filter by category"
        class="gallery-select w-full appearance-none border border-stroke bg-panel px-3 py-2 text-sm text-fg outline-none focus:border-focus"
      >
        <option value="">Category</option>
        {categoryOrder.map((c) => (
          <option value={c}>{categoryLabels[c]}</option>
        ))}
      </select>

      <select
        data-gallery-filter="status"
        aria-label="Filter by status"
        class="gallery-select w-full appearance-none border border-stroke bg-panel px-3 py-2 text-sm text-fg outline-none focus:border-focus"
      >
        <option value="">Status</option>
        {statuses.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>

    <div class="mt-auto flex items-center justify-between gap-2 border-t border-stroke pt-4">
      <span class="text-xs text-fg-muted">
        <span data-gallery-counter>{totalCount}</span> of {totalCount}
      </span>
      <button
        type="button"
        data-gallery-clear
        class="border border-stroke px-3 py-1.5 text-xs text-fg-muted hover:bg-panel-muted hover:text-fg cursor-pointer"
      >
        Clear all
      </button>
    </div>
  </div>

  {/* Main — auto-fit grid of component cards. */}
  <main id="main" class="p-6">
    <ul class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(420px,1fr))]">
      {components.map(({ entry: item, thumbUrl }) => (
        <li
          data-gallery-item
          data-cat={item.data.category}
          data-status={item.data.status}
          data-text={`${item.data.title} ${item.data.description} ${item.data.category}`}
        >
          <a
            href={`/components/${item.id}/`}
            class="group rounded-md overflow-clip flex h-full flex-col border border-stroke bg-panel transition hover:border-stroke-strong focus-visible:border-focus focus-visible:outline-none"
          >
            {/* Preview — real screenshot if one exists at /thumbs/<id>.<ext>,
                neutral canvas-colored placeholder otherwise. */}
            <div class="relative flex aspect-video items-center justify-center overflow-hidden border-b border-stroke bg-canvas">
              {thumbUrl ? (
                <img
                  src={thumbUrl}
                  alt={`${item.data.title} preview`}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                />
              ) : (
                <span class="text-xs uppercase tracking-[0.2em] text-fg-subtle group-hover:text-fg-muted transition">
                  {categoryLabels[item.data.category]}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col gap-2 p-4">
              <div class="flex items-baseline justify-between gap-2">
                <h2 class="text-sm font-semibold text-fg">{item.data.title}</h2>
                <span class="text-[10px] uppercase tracking-wider text-fg-subtle">
                  {item.data.status}
                </span>
              </div>
              <p class="text-xs text-fg-muted line-clamp-2">
                {item.data.description}
              </p>
              <p class="mt-auto pt-3 text-[11px] uppercase tracking-wider text-fg-subtle group-hover:text-fg transition">
                Open →
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p
      data-gallery-empty
      hidden
      class="mt-8 border border-stroke px-6 py-16 text-center text-sm text-fg-muted"
    >
      No components match your filters.
    </p>
  </main>
</Layout>

<style is:global>
  /* Custom chevron for the filter selects (since `appearance-none` strips it). */
  .gallery-select {
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238a8a8a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
    background-position: right 0.625rem center;
    background-repeat: no-repeat;
    background-size: 1rem;
    padding-right: 2rem;
  }

  /* Strip the browser-supplied search clear UI — we render our own. */
  [data-gallery-search]::-webkit-search-cancel-button,
  [data-gallery-search]::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>

<script>
  // Combined filter: search + category + status. An item is visible only if
  // every active filter accepts it. Counter and "Clear all" track state.
  type Filters = { search: string; category: string; status: string };

  const fuzzyMatch = (q: string, t: string) => {
    if (!q) return true;
    const lq = q.toLowerCase();
    const lt = t.toLowerCase();
    if (lt.includes(lq)) return true;
    let qi = 0;
    for (let ti = 0; ti < lt.length && qi < lq.length; ti++) {
      if (lt[ti] === lq[qi]) qi++;
    }
    return qi === lq.length;
  };

  const isMacLike = () => {
    const nav = navigator as Navigator & {
      userAgentData?: { platform?: string };
    };
    const platform = nav.userAgentData?.platform || navigator.platform || "";
    return /Mac|iPhone|iPad|iPod/i.test(platform);
  };

  const init = () => {
    const searchInput = document.querySelector<HTMLInputElement>(
      "[data-gallery-search]",
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>("[data-gallery-item]"),
    );
    const counter = document.querySelector<HTMLElement>(
      "[data-gallery-counter]",
    );
    const empty = document.querySelector<HTMLElement>("[data-gallery-empty]");
    const clearBtn = document.querySelector<HTMLButtonElement>(
      "[data-gallery-clear]",
    );
    const filterSelects = Array.from(
      document.querySelectorAll<HTMLSelectElement>("[data-gallery-filter]"),
    );
    const shortcutBadge = document.querySelector<HTMLElement>(
      "[data-gallery-search-shortcut]",
    );
    const shortcutMod = shortcutBadge?.querySelector<HTMLElement>(
      "[data-gallery-search-shortcut-mod]",
    );
    const searchClear = document.querySelector<HTMLButtonElement>(
      "[data-gallery-search-clear]",
    );
    if (!searchInput || items.length === 0) return;

    if (shortcutMod && isMacLike()) shortcutMod.textContent = "⌘";

    document.addEventListener("keydown", (e) => {
      const isMod = isMacLike() ? e.metaKey : e.ctrlKey;
      if (!isMod || e.key.toLowerCase() !== "k") return;
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    });

    const state: Filters = { search: "", category: "", status: "" };

    const apply = () => {
      let visible = 0;
      for (const item of items) {
        const cat = item.dataset.cat ?? "";
        const status = item.dataset.status ?? "";
        const text = item.dataset.text ?? "";
        const match =
          (state.category === "" || state.category === cat) &&
          (state.status === "" || state.status === status) &&
          fuzzyMatch(state.search, text);
        item.toggleAttribute("hidden", !match);
        if (match) visible++;
      }
      if (counter) counter.textContent = String(visible);
      if (empty) empty.toggleAttribute("hidden", visible !== 0);
    };

    // Badge + clear button share the same right-edge slot — exactly one
    // visible at a time depending on whether the input has text.
    const updateRightSlot = () => {
      const hasText = searchInput.value !== "";
      if (shortcutBadge) shortcutBadge.toggleAttribute("hidden", hasText);
      if (searchClear) searchClear.toggleAttribute("hidden", !hasText);
    };

    searchInput.addEventListener("input", () => {
      state.search = searchInput.value.trim();
      apply();
      updateRightSlot();
    });

    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchInput.value !== "") {
        e.preventDefault();
        searchInput.value = "";
        state.search = "";
        apply();
        updateRightSlot();
      }
    });

    searchClear?.addEventListener("click", () => {
      searchInput.value = "";
      state.search = "";
      apply();
      updateRightSlot();
      searchInput.focus();
    });

    for (const sel of filterSelects) {
      const key = sel.getAttribute("data-gallery-filter") as keyof Filters;
      sel.addEventListener("change", () => {
        state[key] = sel.value;
        apply();
      });
    }

    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      state.search = "";
      for (const sel of filterSelects) {
        sel.value = "";
        const key = sel.getAttribute("data-gallery-filter") as keyof Filters;
        state[key] = "";
      }
      apply();
      updateRightSlot();
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
